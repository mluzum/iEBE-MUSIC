# Base image pinned by digest (see docker/Dockerfile for the rationale).
FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

LABEL org.opencontainers.image.source="https://github.com/mluzum/iEBE-MUSIC"

RUN export DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true && \
    apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        cmake-data \
        curl \
        g++ \
        gcc \
        gfortran \
        git \
        hdf5-tools \
        libfftw3-dev \
        libgsl-dev \
        libhdf5-dev \
        libeigen3-dev \
        libz-dev \
        make \
        pkg-config \
        python3 \
        python3-pip \
        rsync \
        time \
        vim \
        wget \
        build-essential \
        openmpi-bin \
        libopenmpi-dev \
        libboost-all-dev \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install pre-reqs python packages. All pinned -- see docker/Dockerfile for why
# `freestream` in particular must not float. Versions match docker/Dockerfile.
#
# rsync is required: the Pythia8 Makefile install target uses it exclusively
# (five `rsync -a` calls, no cp fallback), so without it `make install` dies with
# Error 127. The el9 image already installed it; this one did not.
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir \
        numpy==1.24.4 \
        scipy==1.10.1 \
        h5py==3.14.0 \
        PyYAML==6.0.3 \
        joblib==1.5.3 \
        mpmath==1.4.1 \
        freestream==1.0.1

ENV HOME /opt/

# download and compile the iEBE-MUSIC framework
#
# Framework is fetched by exact commit SHA and the fork URL is hardcoded -- see
# docker/Dockerfile for the rationale and for the bump procedure. The SHA must be
# kept in sync with docker/Dockerfile.
#
# NOTE: this variant previously used ./get_code_packages.sh (the developer script,
# which clones unpinned branches) while the el9 variant used the pinned
# get_code_packages_test.sh. That meant the two images could build different code
# from the same commit. It now uses the pinned script, matching docker/Dockerfile.
RUN cd ${HOME} \
&& mkdir iEBE-MUSIC && cd iEBE-MUSIC \
&& git init -q . \
&& git remote add origin https://github.com/mluzum/iEBE-MUSIC.git \
&& git fetch -q --depth=1 origin d44e634a2c09cba4313d1a3abfc1773e00744e73 \
&& git checkout -q FETCH_HEAD \
&& test "$(git rev-parse HEAD)" = "d44e634a2c09cba4313d1a3abfc1773e00744e73" \
&& cd codes \
&& bash ./get_code_packages_test.sh \
&& ./compile_code_packages.sh \
&& cd ../EOS_database \
&& bash download_EOSdatabase1D.sh \
&& bash download_QGPViscositydatabase1D.sh \
&& cd ../config/BESPost \
&& bash download_posteriorChain.sh \
&& cd ../arXiv_2408.00537 \
&& bash download_posteriorChain.sh


# Same post-build slimming as docker/Dockerfile -- see the keep-list and the
# rationale there. smash_code, urqmd_code and /opt/pythia8315 are kept because
# the built smash links libpythia8.so from /opt/pythia8315/lib.
RUN set -eux; \
    C=/opt/iEBE-MUSIC/codes; \
    rm -rf $C/MUSIC_code/build $C/MUSIC_code/src $C/MUSIC_code/tests \
           $C/MUSIC_code/doxygen $C/MUSIC_code/utilities \
           $C/MUSIC_code/example_inputfiles; \
    rm -rf $C/iSS_code/build $C/iSS_code/lib $C/iSS_code/src \
           $C/iSS_code/utilities $C/iSS_code/tests $C/iSS_code/EOS.tar.gz; \
    rm -rf $C/hadronic_afterburner_toolkit_code/src \
           $C/hadronic_afterburner_toolkit_code/unit_tests; \
    rm -rf $C/3dMCGlauber_code/src $C/3dMCGlauber_code/build; \
    rm -rf $C/ipglasma_code/src $C/ipglasma_code/build; \
    rm -rf $C/kompost_code/src; \
    rm -rf $C/trento_code/src $C/trento_code/test; \
    rm -rf $C/photonEmission_hydroInterface_code/src; \
    for p in \
        $C/MUSIC_code/MUSIChydro $C/MUSIC_code/EOS $C/MUSIC_code/tables \
        $C/iSS_code/iSS.e $C/iSS_code/iSS_tables \
        $C/hadronic_afterburner_toolkit_code/hadronic_afterburner_tools.e \
        $C/hadronic_afterburner_toolkit_code/EOS \
        $C/hadronic_afterburner_toolkit_code/ebe_scripts \
        $C/3dMCGlauber_code/3dMCGlb.e $C/3dMCGlauber_code/eps09 \
        $C/3dMCGlauber_code/tables \
        $C/ipglasma_code/ipglasma $C/ipglasma_code/utilities \
        $C/ipglasma_code/nucleusConfigurations $C/ipglasma_code/tables \
        $C/kompost_code/EKT $C/kompost_code/KoMPoST.exe \
        $C/trento_code/build/src/trento \
        $C/photonEmission_hydroInterface_code/hydro_photonEmission.e \
        $C/photonEmission_hydroInterface_code/ph_rates \
        $C/isobar_sampler_code/exec/build_isobars.py \
        $C/smash_code/build/smash $C/urqmd_code/urqmd/urqmd.e \
    ; do \
        test -e "$p" || { echo "MISSING after slimming: $p" >&2; exit 1; }; \
    done

ENV PYTHONIOENCODING utf-8

WORKDIR ${HOME}/iEBE-MUSIC

CMD /bin/bash
