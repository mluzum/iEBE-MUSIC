# Base image pinned by digest (see docker/Dockerfile for the rationale).
FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

LABEL org.opencontainers.image.source="https://github.com/mluzum/iEBE-MUSIC"

RUN export DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true && \
    apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        cmake-data \
        curl \
        g++ \
        gcc \
        gfortran \
        git \
        hdf5-tools \
        libfftw3-dev \
        libgsl-dev \
        libhdf5-dev \
        libeigen3-dev \
        libz-dev \
        make \
        pkg-config \
        python3 \
        python3-pip \
        rsync \
        time \
        vim \
        wget \
        build-essential \
        openmpi-bin \
        libopenmpi-dev \
        libboost-all-dev \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install pre-reqs python packages. All pinned -- see docker/Dockerfile for why
# `freestream` in particular must not float. Versions match docker/Dockerfile.
#
# rsync is required: the Pythia8 Makefile install target uses it exclusively
# (five `rsync -a` calls, no cp fallback), so without it `make install` dies with
# Error 127. The el9 image already installed it; this one did not.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
        numpy==1.24.4 \
        scipy==1.10.1 \
        h5py==3.14.0 \
        PyYAML==6.0.3 \
        joblib==1.5.3 \
        mpmath==1.4.1 \
        freestream==1.0.1

ENV HOME /opt/

# download and compile the iEBE-MUSIC framework
#
# Framework is fetched by exact commit SHA and the fork URL is hardcoded -- see
# docker/Dockerfile for the rationale and for the bump procedure. The SHA must be
# kept in sync with docker/Dockerfile.
#
# NOTE: this variant previously used ./get_code_packages.sh (the developer script,
# which clones unpinned branches) while the el9 variant used the pinned
# get_code_packages_test.sh. That meant the two images could build different code
# from the same commit. It now uses the pinned script, matching docker/Dockerfile.
RUN cd ${HOME} \
&& mkdir iEBE-MUSIC && cd iEBE-MUSIC \
&& git init -q . \
&& git remote add origin https://github.com/mluzum/iEBE-MUSIC.git \
&& git fetch -q --depth=1 origin 46de3904073e998c835439de9bebcc238559617c \
&& git checkout -q FETCH_HEAD \
&& test "$(git rev-parse HEAD)" = "46de3904073e998c835439de9bebcc238559617c" \
&& cd codes \
&& bash ./get_code_packages_test.sh \
&& ./compile_code_packages.sh \
&& cd ../EOS_database \
&& bash download_EOSdatabase1D.sh \
&& bash download_QGPViscositydatabase1D.sh \
&& cd ../config/BESPost \
&& bash download_posteriorChain.sh \
&& cd ../arXiv_2408.00537 \
&& bash download_posteriorChain.sh

ENV PYTHONIOENCODING utf-8

WORKDIR ${HOME}/iEBE-MUSIC

CMD /bin/bash
