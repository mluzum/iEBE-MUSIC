+
+void FSSW::get_PTB_bulk_parameters(const double T, const double bulkPi,
+                                   double &lambda_Pi, double &z_Pi,
+                                   bool &clamped) const {
+    const int n_T = ptb_T_grid_.size();
+    const int n_u = ptb_u_grid_.size();
+    int iT = 0;
+    double fT = 0.;
+    if (n_T > 1) {
+        const double r = ((T - ptb_T_grid_[0])
+                          /(ptb_T_grid_[1] - ptb_T_grid_[0]));
+        iT = std::max(0, std::min(n_T - 2, static_cast<int>(r)));
+        fT = std::max(0., std::min(1., r - iT));
+    }
+    auto e_at = [&](int iu) {
+        return(n_T > 1 ? (1. - fT)*ptb_e_[iT][iu] + fT*ptb_e_[iT+1][iu]
+                       : ptb_e_[0][iu]);
+    };
+    auto P_at = [&](int iu) {
+        return(n_T > 1 ? (1. - fT)*ptb_P_[iT][iu] + fT*ptb_P_[iT+1][iu]
+                       : ptb_P_[0][iu]);
+    };
+    const int iu0 = 160;  // u = 0
+    const double e0 = e_at(iu0);
+    const double target = (P_at(iu0) + bulkPi)/e0;  // (P + Pi)/e
+
+    clamped = false;
+    double u, e_u;
+    if (target <= P_at(0)/e_at(0)) {
+        u = ptb_u_grid_[0];
+        e_u = e_at(0);
+        clamped = true;
+    } else if (target >= P_at(n_u - 1)/e_at(n_u - 1)) {
+        u = ptb_u_grid_[n_u - 1];
+        e_u = e_at(n_u - 1);
+        clamped = true;
+    } else {
+        int lo = 0, hi = n_u - 1;
+        while (hi - lo > 1) {
+            const int mid = (lo + hi)/2;
+            if (P_at(mid)/e_at(mid) <= target) {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        const double R_lo = P_at(lo)/e_at(lo);
+        const double R_hi = P_at(hi)/e_at(hi);
+        const double frac = (target - R_lo)/(R_hi - R_lo);
+        u = ptb_u_grid_[lo] + frac*(ptb_u_grid_[hi] - ptb_u_grid_[lo]);
+        e_u = e_at(lo) + frac*(e_at(hi) - e_at(lo));
+    }
+    lambda_Pi = exp(u) - 1.;
+    z_Pi = e0/e_u;
+}
+
+
+void FSSW::prepare_PTB_cells() {
+    if (bINCLUDE_BULK_DELTAF) {
+        double T_min = 1e30, T_max = -1e30;
+        for (long l = 0; l < FO_length; l++) {
+            T_min = std::min(T_min, static_cast<double>(FOsurf_ptr[l].Tdec));
+            T_max = std::max(T_max, static_cast<double>(FOsurf_ptr[l].Tdec));
+        }
+        build_PTB_bulk_table(T_min, T_max);
+    }
+
+    ptb_A_.resize(FO_length);
+    ptb_z_.resize(FO_length);
+    std::vector<double> visCoefficients;
+    double w_tot = 0., w_shear_reg = 0., w_bulk_clamped = 0.;
+    for (long l = 0; l < FO_length; l++) {
+        const FO_surf_LRF *surf = &FOsurf_ptr[l];
+        double lambda_Pi = 0., z_Pi = 1.;
+        bool clamped = false;
+        if (bINCLUDE_BULK_DELTAF) {
+            get_PTB_bulk_parameters(surf->Tdec, surf->bulkPi,
+                                    lambda_Pi, z_Pi, clamped);
+        }
+        const double a = 1. + lambda_Pi;
+
+        // shear part S = pi/(2 beta_pi), traceless and symmetric in the LRF
+        double S[3][3] = {{0., 0., 0.}, {0., 0., 0.}, {0., 0., 0.}};
+        if (bINCLUDE_SHEAR_DELTAF) {
+            getCENEOSBQSCoefficients(surf->Edec, std::abs(surf->Bn),
+                                     visCoefficients);
+            const double beta_pi = visCoefficients[2];   // GeV/fm^3
+            if (beta_pi > 0.) {
+                const double c = 1./(2.*beta_pi);
+                S[0][0] = c*surf->piLRF_xx;
+                S[0][1] = S[1][0] = c*surf->piLRF_xy;
+                S[0][2] = S[2][0] = c*surf->piLRF_xz;
+                S[1][1] = c*surf->piLRF_yy;
+                S[1][2] = S[2][1] = c*surf->piLRF_yz;
+                S[2][2] = -(S[0][0] + S[1][1]);
+            }
+        }
+        double s_reg = 1.;
+        const double lam_min = smallest_eigenvalue_sym3(S);
+        if (a + lam_min < ptb_min_eigenvalue_*a) {
+            s_reg = (1. - ptb_min_eigenvalue_)*a/(-lam_min);
+        }
+        ptb_A_[l] = {a + s_reg*S[0][0], s_reg*S[0][1], s_reg*S[0][2],
+                     a + s_reg*S[1][1], s_reg*S[1][2], a + s_reg*S[2][2]};
+        ptb_z_[l] = z_Pi;
+
+        const double w = std::max(0., static_cast<double>(surf->da_mu_LRF[0]));
+        w_tot += w;
+        if (s_reg < 1.) w_shear_reg += w;
+        if (clamped) w_bulk_clamped += w;
+    }
+    if (echoLevel_ > 0 && w_tot > 0.) {
+        messager_ << "PTB delta f: " << FO_length << " cells; emission-weighted "
+                  << "fraction with the shear part regulated: "
+                  << w_shear_reg/w_tot << ", with lambda_Pi clamped: "
+                  << w_bulk_clamped/w_tot;
+        messager_.flush("info");
+    }
+}
