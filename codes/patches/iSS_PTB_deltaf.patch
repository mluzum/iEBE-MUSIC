+//***************************************************************************
+// PTB (Pratt-Torrieri-Bernhard) modified-equilibrium delta f
+//
+// In the local rest frame
+//     f(p) = z_Pi/det(A) f_eq(sqrt(m^2 + |A^{-1} p|^2)/T),
+//     A_ij = (1 + lambda_Pi) delta_ij + pi_ij/(2 beta_pi),
+// which is positive by construction.  To first order in pi it is the
+// Chapman-Enskog shear delta f that bulk_deltaf_kind 21 uses (same beta_pi
+// table).  lambda_Pi and z_Pi are fixed per cell by Landau matching of the
+// kinetic hadron gas being sampled: lambda_Pi reproduces P + Pi and z_Pi
+// keeps e (J. Bernhard, PhD thesis, Duke 2018; M. McNelis, D. Everett,
+// U. Heinz, Comput. Phys. Commun. 258 (2021) 107604).  The density is
+// z_Pi n_eq, so a cell emits z_Pi N_eq particles.
+//
+// Sampling: draw p' from f_eq at T with the equilibrium sampler, map
+// p = A p' and keep the Cooper-Frye flux acceptance.  There is no
+// (1 + delta f)/2 acceptance, so nothing is clamped.
+//
+// Regulator: A must stay positive definite.  Where the shear part would
+// push the smallest eigenvalue of A below ptb_min_eigenvalue*(1 + lambda_Pi)
+// it is scaled down to that bound, and where P + Pi is out of reach of an
+// isotropic rescaling lambda_Pi is clamped.  Both are reported.
+//***************************************************************************
+namespace {
+double smallest_eigenvalue_sym3(const double S[3][3]) {
+    const double p1 = (S[0][1]*S[0][1] + S[0][2]*S[0][2] + S[1][2]*S[1][2]);
+    if (p1 == 0.) {
+        return(std::min(S[0][0], std::min(S[1][1], S[2][2])));
+    }
+    const double q = (S[0][0] + S[1][1] + S[2][2])/3.;
+    const double p2 = ((S[0][0] - q)*(S[0][0] - q) + (S[1][1] - q)*(S[1][1] - q)
+                       + (S[2][2] - q)*(S[2][2] - q) + 2.*p1);
+    const double p = sqrt(p2/6.);
+    double B[3][3];
+    for (int i = 0; i < 3; i++) {
+        for (int j = 0; j < 3; j++) {
+            B[i][j] = (S[i][j] - (i == j ? q : 0.))/p;
+        }
+    }
+    const double detB = (B[0][0]*(B[1][1]*B[2][2] - B[1][2]*B[2][1])
+                         - B[0][1]*(B[1][0]*B[2][2] - B[1][2]*B[2][0])
+                         + B[0][2]*(B[1][0]*B[2][1] - B[1][1]*B[2][0]));
+    const double r = std::max(-1., std::min(1., detB/2.));
+    const double phi = acos(r)/3.;
+    return(q + 2.*p*cos(phi + 2.*M_PI/3.));
+}
+}  // namespace
