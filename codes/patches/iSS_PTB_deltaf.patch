+void FSSW::build_PTB_bulk_table(const double T_min, const double T_max) {
+    // species with the same mass and statistics are merged
+    std::vector<double> group_mass, group_degen;
+    std::vector<int> group_sign;
+    for (int n = 0; n < number_of_chosen_particles; n++) {
+        const particle_info *particle = (
+                            &particles[chosen_particles_sampling_table[n]]);
+        bool found = false;
+        for (unsigned int g = 0; g < group_mass.size(); g++) {
+            if (std::abs(group_mass[g] - particle->mass) < 1e-6
+                    && group_sign[g] == particle->sign) {
+                group_degen[g] += particle->gspin;
+                found = true;
+                break;
+            }
+        }
+        if (!found) {
+            group_mass.push_back(particle->mass);
+            group_degen.push_back(particle->gspin);
+            group_sign.push_back(particle->sign);
+        }
+    }
+
+    // u = ln(1 + lambda_Pi) on [-2, 1.5]; u = 0 is node 160
+    const int n_u = 281;
+    ptb_u_grid_.resize(n_u);
+    for (int i = 0; i < n_u; i++) {
+        ptb_u_grid_[i] = -2.0 + 0.0125*i;
+    }
+    std::vector<double> scale(n_u);
+    for (int i = 0; i < n_u; i++) {
+        scale[i] = exp(ptb_u_grid_[i]);
+    }
+
+    // T rows 1 MeV apart (a single row for an isothermal surface)
+    const double dT = 0.001;
+    int n_T = 1;
+    if (T_max - T_min > 1e-6) {
+        n_T = std::min(200, static_cast<int>(ceil((T_max - T_min)/dT)) + 1);
+    }
+    ptb_T_grid_.resize(n_T);
+    for (int i = 0; i < n_T; i++) {
+        ptb_T_grid_[i] = (n_T == 1 ? T_min
+                                   : T_min + (T_max - T_min)*i/(n_T - 1.));
+    }
+    ptb_e_.assign(n_T, std::vector<double>(n_u, 0.));
+    ptb_P_.assign(n_T, std::vector<double>(n_u, 0.));
+
+    // e and P of the rescaled equilibrium gas, Simpson in x = p'/T on [0, 30]
+    const int n_x = 120;
+    const double x_max = 30.;
+    const double dx = x_max/n_x;
+    const double prefactor = 1./(2.*M_PI*M_PI*hbarC*hbarC*hbarC);
+    for (int iT = 0; iT < n_T; iT++) {
+        const double T = ptb_T_grid_[iT];
+        for (unsigned int g = 0; g < group_mass.size(); g++) {
+            const double m = group_mass[g];
+            for (int k = 1; k <= n_x; k++) {
+                const double simpson = (k == n_x ? 1. : (k % 2 == 1 ? 4. : 2.));
+                const double p = k*dx*T;
+                const double arg = sqrt(m*m + p*p)/T;
+                if (arg > 700.) continue;
+                const double f = 1./(exp(arg) + group_sign[g]);
+                const double W = (prefactor*group_degen[g]*simpson*dx/3.*T
+                                  *p*p*f);
+                for (int iu = 0; iu < n_u; iu++) {
+                    const double ps = scale[iu]*p;
+                    const double Es = sqrt(m*m + ps*ps);
+                    ptb_e_[iT][iu] += W*Es;
+                    ptb_P_[iT][iu] += W*ps*ps/(3.*Es);
+                }
+            }
+        }
+        for (int iu = 1; iu < n_u; iu++) {
+            if (ptb_P_[iT][iu]/ptb_e_[iT][iu]
+                    <= ptb_P_[iT][iu-1]/ptb_e_[iT][iu-1]) {
+                messager_ << "PTB bulk table: P/e not increasing in lambda_Pi "
+                          << "at T = " << T << " GeV.";
+                messager_.flush("error");
+                exit(1);
+            }
+        }
+    }
+    if (echoLevel_ > 0) {
+        messager_ << "PTB bulk table: " << group_mass.size()
+                  << " mass groups, " << n_T << " temperature rows in ["
+                  << T_min << ", " << T_max << "] GeV, kinetic e = "
+                  << ptb_e_[0][160] << " GeV/fm^3, P = " << ptb_P_[0][160]
+                  << " GeV/fm^3 at T = " << ptb_T_grid_[0] << " GeV.";
+        messager_.flush("info");
+    }
+}
