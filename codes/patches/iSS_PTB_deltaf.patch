+
+int FSSW::sample_momentum_PTB(
+        const double mass, const int sign, const double mu,
+        const FO_surf_LRF *surf, const std::array<double, 6> &A,
+        double &pT, double &phi, double &y_minus_eta_s) {
+    const double Tdec = surf->Tdec;
+    const double dsigam_fac = (std::abs(surf->da_mu_LRF[0])
+                            + sqrt(  surf->da_mu_LRF[1]*surf->da_mu_LRF[1]
+                                   + surf->da_mu_LRF[2]*surf->da_mu_LRF[2]
+                                   + surf->da_mu_LRF[3]*surf->da_mu_LRF[3]));
+    int tries = 1;
+    const int maximum_impatience = 5000;
+    while (tries < maximum_impatience) {
+        // p' from the equilibrium distribution, then p = A p'
+        double p_mag = momentum_sampler_ptr_->Sample_a_momentum(mass, Tdec, mu,
+                                                                sign);
+        double phi_candidate = 2*M_PI*ran_gen_ptr->rand_uniform();
+        double cos_theta = 2.*ran_gen_ptr->rand_uniform() - 1.;
+        double sin_theta = sqrt(1. - cos_theta*cos_theta);
+        const double qx = p_mag*sin_theta*cos(phi_candidate);
+        const double qy = p_mag*sin_theta*sin(phi_candidate);
+        const double qz = p_mag*cos_theta;
+
+        const double px = A[0]*qx + A[1]*qy + A[2]*qz;
+        const double py = A[1]*qx + A[3]*qy + A[4]*qz;
+        const double pz = A[2]*qx + A[4]*qy + A[5]*qz;
+        const double p0 = sqrt(mass*mass + px*px + py*py + pz*pz);
+
+        double pdsigma = (  p0*surf->da_mu_LRF[0] + px*surf->da_mu_LRF[1]
+                          + py*surf->da_mu_LRF[2] + pz*surf->da_mu_LRF[3]);
+        double accept_prob = std::max(0., std::min(1., pdsigma/p0/dsigam_fac));
+
+        if (ran_gen_ptr->rand_uniform() < accept_prob) {
+            VecD4 pLRF = {p0, px, py, pz};
+            VecD4 umu = {surf->u_tz[0], surf->u_tz[1],
+                         surf->u_tz[2], surf->u_tz[3]};
+            VecD4 pLab = {0., 0., 0., 0.};
+            boost_vector_back_to_lab_frame(pLRF, pLab, umu);
+
+            double y = 0.5*log((pLab[0] + pLab[3])/(pLab[0] - pLab[3]));
+            if (!std::isnan(y) && !std::isinf(y)) {
+                pT = sqrt(pLab[1]*pLab[1] + pLab[2]*pLab[2]);
+                phi = atan2(pLab[2], pLab[1]);
+                y_minus_eta_s = y - surf->eta;
+                return(1);
+            }
+        }
+        tries++;
+    }
+    return(0);
+}
+
+
+int FSSW::sample_momentum(
+        const double mass, const int sign,
+        const int baryon, const int strange, const int charge,
+        const long FO_idx, const FO_surf_LRF *surf,
+        const std::vector<double> visCoefficients,
+        const double deltaf_qmu_coeff,
+        double &pT, double &phi, double &y_minus_eta_s) {
+    if (deltaf_model_ == 1) {
+        const double mu = std::min(mass, static_cast<double>(
+                baryon*surf->muB + strange*surf->muS + charge*surf->muQ));
+        return(sample_momentum_PTB(mass, sign, mu, surf, ptb_A_[FO_idx],
+                                   pT, phi, y_minus_eta_s));
+    }
+    return(sample_momemtum_from_a_fluid_cell(
+                mass, sign, baryon, strange, charge, surf, visCoefficients,
+                deltaf_qmu_coeff, pT, phi, y_minus_eta_s));
+}
